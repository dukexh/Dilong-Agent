# Alibaba Bailian, Beijing region. Both models share this endpoint and API key.
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=
MODEL_NAME=qwen4-max
MODEL_MAX_OUTPUT_TOKENS=4096
MODEL_THINKING_BUDGET=1024
IMAGE_MODEL_NAME=qwen-image-3.0-pro
# DashScope is the verified image protocol for the default Beijing endpoint.
IMAGE_API_PROTOCOL=dashscope
# Independent TikHub account key for real social post search.
TIKHUB_BASE_URL=https://api.tikhub.io
TIKHUB_API_KEY=
# Optional origins for development. Production should use a same-origin reverse proxy.
ALLOWED_ORIGINS=http://127.0.0.1:51458,http://localhost:51458,http://127.0.0.1:51459
